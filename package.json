{
  "name": "ohlcraft",
  "version": "0.1.2",
  "description": "A deeply customizable, canvas-based financial chart for React and Next.js.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsup && node scripts/ensure-client-directive.mjs",
    "build:demo": "vite build",
    "preview:demo": "vite preview",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "react",
    "nextjs",
    "trading-chart",
    "candlestick",
    "financial-chart",
    "canvas",
    "technical-analysis",
    "ohlc",
    "drawing-tools",
    "theme-studio"
  ],
  "author": "Radin",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radnrp/ohlcraft.git"
  },
  "homepage": "https://github.com/radnrp/ohlcraft#readme",
  "bugs": {
    "url": "https://github.com/radnrp/ohlcraft/issues"
  }
}
